# Base URL of the Wisper API this app proxies to. The browser calls same-origin
# `/wisper/*` and Next rewrites it here (server-side), so there is no CORS.
# Point this at your Wisper host. Defaults to http://localhost:8080 when unset.
# Read by next.config.mjs when the rewrite table is built, so it must be set at
# BUILD time (on Vercel: project environment variables, then redeploy).
# For local dev against a local wisper-api: WISPER_API_URL=http://127.0.0.1:8090
WISPER_API_URL=https://<wisper-host>

# Cognito Hosted UI (public: used in the browser to start sign-in via the
# implicit flow, redirect_uri = this app's origin, which must be an allowed
# callback URL on the app client). Both are baked into the client bundle at
# build time. The app decodes the returned ID token to gate the UI to the
# `admin` group; the Wisper API independently verifies the token. Leave BOTH
# unset for local dev: the sign-in screen then accepts a pasted admin-scoped
# Wisper API key (wck_...) instead; see the "Local development" section of the
# README.
NEXT_PUBLIC_COGNITO_DOMAIN=https://<your-user-pool-domain>.auth.<region>.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=<app-client-id>
